ACEWEATHER_API_PROXY_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_ACEWEATHER_API_BASE=

# Accounts (sign in with an emailed code; syncs saved places and settings).
# Locally, leave these empty: an in-memory store is used and codes print to the dev server log.
# In production all four are needed, or sign-in stays hidden.
AUTH_SECRET=            # 32+ random characters: openssl rand -base64 32
KV_REST_API_URL=        # Upstash Redis (Vercel Marketplace sets these two)
KV_REST_API_TOKEN=
RESEND_API_KEY=
AUTH_EMAIL_FROM=        # e.g. AceWeather <signin@aceweather.app> on a domain verified in Resend
